{
  "mcpServers": {
    "dataguardian": {
      "command": "python",
      "args": ["-m", "dataguardian.server"],
      "cwd": "${workspaceFolder}/dataguardian",
      "env": {
        "OPENMETADATA_HOST": "http://localhost:8585",
        "OPENMETADATA_JWT_TOKEN": "your-jwt-token-here",
        "GEMINI_API_KEY": "your-gemini-api-key-here",
        "GEMINI_MODEL": "gemini-2.0-flash",
        "LINEAGE_MAX_DEPTH": "5"
      },
      "disabled": false,
      "autoApprove": [
        "search_sensitive",
        "breach_impact",
        "orphaned_sensitive_assets",
        "data_access_chain",
        "compliance_report"
      ]
    }
  }
}
