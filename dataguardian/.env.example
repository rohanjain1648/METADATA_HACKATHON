# OpenMetadata connection
OPENMETADATA_HOST=http://localhost:8585
OPENMETADATA_JWT_TOKEN=your-jwt-token-here

# LLM for auto-classification (Gemini via OpenAI-compatible endpoint)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# Optional: max lineage traversal depth
LINEAGE_MAX_DEPTH=5
